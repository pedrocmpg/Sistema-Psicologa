# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Veja o README para o passo a passo completo de como obter esses valores.

# ---------------------------------------------------------------------------
# FRONTEND (Vite / Netlify) — só estas duas. Tudo que começa com VITE_ vai para
# o JavaScript público do site; nunca coloque segredo com esse prefixo.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA

# ---------------------------------------------------------------------------
# EDGE FUNCTIONS (WhatsApp) — NÃO vão para o .env do site nem para o Netlify.
# Em produção: `npx supabase secrets set NOME=valor` (ou --env-file, veja o README).
# Localmente: copie este bloco para supabase/functions/.env (fora do git) e rode
# `npx supabase functions serve --env-file supabase/functions/.env`.
# ---------------------------------------------------------------------------

# "mock" (padrão: só registra no log) | "evolution" | "zapi"
# WHATSAPP_PROVIDER=mock

# true = faz tudo (inclusive gravar em `notificacoes`) sem chamar o provedor
# WHATSAPP_DRY_RUN=false

# Segredo compartilhado com o Database Webhook (header x-webhook-secret).
# Gere um valor longo e aleatório, ex.: `openssl rand -hex 32`.
# WEBHOOK_SECRET=

# Evolution API (self-hosted)
# EVOLUTION_API_URL=https://evolution.seu-dominio.com.br
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=consultorio

# Z-API (alternativa paga)
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
